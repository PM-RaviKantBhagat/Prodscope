# Required in production: a Gemini API key from https://aistudio.google.com/apikey (free tier works).
GEMINI_API_KEY=
# Postgres connection string (e.g. Neon free tier). Without it, data is kept in .data/db.json (local dev only).
DATABASE_URL=
# Random string used to anonymise visitor IPs for the daily free quota.
IP_SALT=
# Optional tuning
FREE_PER_PERSON_PER_DAY=3
FREE_TOTAL_PER_DAY=15
CACHE_DAYS=30
# "auto" picks the newest stable Gemini Flash model. Set a model id to pin one.
GEMINI_MODEL=auto
# Set to 1 to return sample reports without calling the AI (for trying the UI).
MOCK_AI=
