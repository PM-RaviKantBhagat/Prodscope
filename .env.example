# Required in production: your Claude API key (console.anthropic.com). Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Postgres connection string (e.g. Neon free tier). Without it, data is kept in .data/db.json (local dev only).
DATABASE_URL=
# Random string used to anonymise visitor IPs for the daily free quota.
IP_SALT=
# Optional tuning
FREE_PER_PERSON_PER_DAY=3
FREE_TOTAL_PER_DAY=15
CACHE_DAYS=30
# CLAUDE_MODEL=claude-opus-5-5
# Set to 1 to return sample reports without calling Claude (for trying the UI).
MOCK_AI=
